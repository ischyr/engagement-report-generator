# Dependencies
node_modules/

# Build output
dist/
.vite/
coverage/

# Local configuration — contains secrets. Copy .env.example instead.
.env
.env.local
.env.*.local

# Runtime storage: uploaded templates and generated reports are per-install,
# so the directories are tracked but their contents are not.
server/storage/templates/*
!server/storage/templates/.gitkeep
server/storage/tmp/*
!server/storage/tmp/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Word lock files, created while a report is open
~$*.docx
