# ---------------------------------------------------------------------------
# Engy Report — server configuration
# Copy this file to `.env` (same directory) and adjust as needed.
# ---------------------------------------------------------------------------

# HTTP port the API listens on.
PORT=4000

# Local MongoDB. The database name (engy-report) is part of the URI.
MONGODB_URI=mongodb://127.0.0.1:27017/engy-report

# Secrets used to sign JWTs. CHANGE THESE before exposing the app to anyone.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# Encryption key for the per-engagement credential vault. 32 bytes, hex or base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deliberately separate from the JWT secrets, which are rotated routinely — the vault
# hanging off one would mean rotating it silently destroyed stored credentials. Without
# this the vault stays off rather than keeping secrets in the clear. Back it up: lose it
# and the credentials stored under it cannot be read.
VAULT_KEY=

# Origin allowed to call the API with credentials (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Where this instance is reached, for links in the emails it sends. A link in a mail
# client has to be absolute; without this it falls back to the first CORS origin above,
# which on a development machine is the Vite dev server.
APP_URL=http://localhost:5173

# The mail account's password, if you would rather it were not in the database at all.
# Set it here and the field under Settings -> Email is ignored; leave it empty and a
# password typed there is encrypted with VAULT_KEY instead. Gmail and Microsoft both
# want an app password rather than the account password. Everything else about the mail
# server -- host, port, security, the address to send from -- is configured in the app.
SMTP_PASSWORD=

# The assistant's API key, if you would rather it were not in the database at all.
# Set it here and the field under Settings -> Assistant is ignored; leave it empty and
# a key typed there is encrypted with VAULT_KEY instead. Everything else -- the
# endpoint, the model, which of the four jobs are switched on -- is configured in the
# app, and the whole feature stays off until somebody fills it in. A model running on
# this machine (Ollama and friends) needs no key at all.
ASSISTANT_API_KEY=

# Set to "false" to close registration once your accounts exist. The very first
# account is always allowed through and is promoted to admin automatically.
ALLOW_REGISTRATION=true

# Bootstrap admin created by `npm run seed`.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_EMAIL=admin@engy.local

NODE_ENV=development
