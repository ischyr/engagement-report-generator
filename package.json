    "test:report-flow": "npm run test:report-flow --workspace server",
    "test:url-state": "npm run test:url-state --workspace client",
    "test:undo": "npm run test:undo --workspace server",
    "test:housekeeping": "npm run test:housekeeping --workspace server",
    "test:workbench": "npm run test:workbench --workspace server",
    "test:client-question": "npm run test:client-question --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
