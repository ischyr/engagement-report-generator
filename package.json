{
  "name": "engy-report",
  "private": true,
  "version": "1.0.0",
  "description": "Engy Report — a modular pentest engagement report generator driven by .docx templates",
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "docs"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:demo": "npm run seed:demo --workspace server --",
    "make:template": "npm run make:template --workspace server",
    "make:redteam-template": "npm run make:redteam-template --workspace server",
    "make:proposal-templates": "npm run make:proposal-templates --workspace server",
    "tag:template": "npm run tag:template --workspace server --",
    "smoke:server": "npm run smoke --workspace server",
    "smoke:client": "npm run smoke --workspace client",
    "test:contrast": "npm run test:contrast --workspace client",
    "test:images": "npm run test:images --workspace client",
    "test:collab-editor": "npm run test:collab-editor --workspace client",
    "test:resource": "npm run test:resource --workspace client",
    "test:table-paste": "npm run test:table-paste --workspace client",
    "test:collab-rooms": "npm run test:collab-rooms --workspace client",
    "test:keys": "npm run test:keys --workspace client",
    "smoke": "npm run smoke:server && npm run smoke:client && npm run smoke:docs && npm run test:contrast",
    "reset-2fa": "npm run reset-2fa --workspace server --",
    "purge-trash": "npm run purge-trash --workspace server --",
    "backup": "npm run backup --workspace server --",
    "restore": "npm run restore --workspace server --",
    "test:backup": "npm run test:backup --workspace server",
    "remind:bookings": "npm run remind:bookings --workspace server --",
    "test:totp": "npm run test:totp --workspace server",
    "make:favicon": "npm run make:favicon --workspace server",
    "test:scan": "npm run test:scan --workspace server",
    "test:cvss4": "npm run test:cvss4 --workspace server",
    "test:charts": "npm run test:charts --workspace server",
    "test:mail": "npm run test:mail --workspace server",
    "test:import": "npm run test:import --workspace server",
    "test:figures": "npm run test:figures --workspace server",
    "test:assistant": "npm run test:assistant --workspace server",
    "migrate:media": "npm run migrate:media --workspace server --",
    "backfill:authors": "npm run backfill:authors --workspace server --",
    "backfill:evidence": "npm run backfill:evidence --workspace server --",
    "fix:identifiers": "npm run fix:identifiers --workspace server --",
    "media:gc": "npm run media:gc --workspace server --",
    "test:media": "npm run test:media --workspace server",
    "test:collab": "npm run test:collab --workspace server",
    "test:tags": "npm run test:tags --workspace server",
    "test:replace": "npm run test:replace --workspace server",
    "test:tracker": "npm run test:tracker --workspace server",
    "test:timeline": "npm run test:timeline --workspace server",
    "test:pdf": "npm run test:pdf --workspace server",
    "test:webhook": "npm run test:webhook --workspace server",
    "test:zipcrypt": "npm run test:zipcrypt --workspace server",
    "test:signing": "npm run test:signing --workspace server",
    "test:copies": "npm run test:copies --workspace server",
    "test:client-claim": "npm run test:client-claim --workspace server",
    "test:intrusive": "npm run test:intrusive --workspace server",
    "test:api": "npm run test:api --workspace server",
    "test:intrusive-tab": "npm run test:intrusive-tab --workspace client",
    "test:collab-socket": "npm run test:collab-socket --workspace server",
    "backfill:lint": "npm run backfill:lint --workspace server",
    "reset-password": "npm run reset-password --workspace server",
    "docs": "npm run dev --workspace docs",
    "build:docs": "npm run build --workspace docs",
    "smoke:docs": "npm run smoke --workspace docs",
    "shots": "node scripts/shots.mjs",
    "make:api-token": "npm run make:api-token --workspace server --",
    "revoke:api-tokens": "npm run revoke:api-tokens --workspace server --",
    "test:chunks": "npm run test:chunks --workspace client",
    "test:live": "npm run test:live --workspace server",
    "test:live-poll": "npm run test:live-poll --workspace client",
    "test:projection": "npm run test:projection --workspace server",
    "test:search": "npm run test:search --workspace server",
    "test:findings-rows": "npm run test:findings-rows --workspace client",
    "test:enumeration-rows": "npm run test:enumeration-rows --workspace client",
    "test:library": "npm run test:library --workspace server",
    "test:library-editor": "npm run test:library-editor --workspace client",
    "test:timeline-window": "npm run test:timeline-window --workspace client",
