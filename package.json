{
  "name": "engy-report",
  "private": true,
  "version": "1.0.0",
  "description": "Engy Report \u2014 a modular pentest engagement report generator driven by .docx templates",
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "docs"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:demo": "npm run seed:demo --workspace server --",
    "make:template": "npm run make:template --workspace server",
    "make:proposal-templates": "npm run make:proposal-templates --workspace server",
    "tag:template": "npm run tag:template --workspace server --",
    "smoke:server": "npm run smoke --workspace server",
    "smoke:client": "npm run smoke --workspace client",
    "test:contrast": "npm run test:contrast --workspace client",
    "smoke": "npm run smoke:server && npm run smoke:client && npm run smoke:docs && npm run test:contrast",
    "reset-2fa": "npm run reset-2fa --workspace server --",
    "purge-trash": "npm run purge-trash --workspace server --",
    "remind:bookings": "npm run remind:bookings --workspace server --",
    "test:totp": "npm run test:totp --workspace server",
    "make:favicon": "npm run make:favicon --workspace server",
    "test:scan": "npm run test:scan --workspace server",
    "test:cvss4": "npm run test:cvss4 --workspace server",
    "migrate:media": "npm run migrate:media --workspace server --",
    "backfill:authors": "npm run backfill:authors --workspace server --",
    "backfill:evidence": "npm run backfill:evidence --workspace server --",
    "fix:identifiers": "npm run fix:identifiers --workspace server --",
    "media:gc": "npm run media:gc --workspace server --",
    "test:media": "npm run test:media --workspace server",
    "test:collab": "npm run test:collab --workspace server",
    "test:tags": "npm run test:tags --workspace server",
    "backfill:lint": "npm run backfill:lint --workspace server",
    "reset-password": "npm run reset-password --workspace server",
    "docs": "npm run dev --workspace docs",
    "build:docs": "npm run build --workspace docs",
    "smoke:docs": "npm run smoke --workspace docs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
